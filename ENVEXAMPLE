# ============================================
# Configuracion de Base de Datos
# ============================================

# Para PostgreSQL (produccion - recomendado)
DATABASE_URL=postgresql://resq:resq@localhost:5432/resq

# Para SQLite (desarrollo local)
# DATABASE_URL=sqlite:///./resq.db


# ============================================
# Configuracion de JWT (Autenticacion)
# ============================================

# Genera una clave segura con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=tu-clave-secreta-super-segura-cambiar-en-produccion
JWT_EXPIRE_MINUTES=1440


# ============================================
# Configuracion de Redis (Cache en Memoria)
# ============================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false


# ============================================
# Configuracion de LiveKit (Llamadas de voz/video)
# ============================================

LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret


# ============================================
# Configuracion de API Base URL
# ============================================

API_BASE_URL=http://localhost:8000
